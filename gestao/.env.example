# Copie para .env.local (local) ou cadastre em Vercel › Settings › Environment Variables.
# Sem estas variáveis o app abre em modo demonstração, com dados fictícios em memória.

# Supabase › Project Settings › API Keys (use a chave publishable, NUNCA a secret)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Evento mostrado na página pública (o mesmo id do supabase/seed.sql)
VITE_EVENTO_ID=c3a1f000-0000-4000-8000-000000000001
